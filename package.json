{
  "name": "dsh-plugin-lark-bridge",
  "version": "0.4.1",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "deepseek",
    "harness",
    "plugin",
    "lark",
    "feishu",
    "lark-super-agent",
    "dispatch"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./lark-super-agent": {
      "types": "./dist/lark-super-agent/index.d.ts",
      "import": "./dist/lark-super-agent.mjs"
    },
    "./lark-super-agent/locale/*.json": "./rows/lark-super-agent/locale/*.json",
    "./lark-super-agent/icon": "./rows/lark-super-agent/icon.svg",
    "./sa-dispatch": {
      "types": "./dist/sa-dispatch/index.d.ts",
      "import": "./dist/sa-dispatch.mjs"
    },
    "./sa-dispatch/locale/*.json": "./rows/sa-dispatch/locale/*.json",
    "./sa-dispatch/icon": "./rows/sa-dispatch/icon.svg",
    "./sa-worker": {
      "types": "./dist/sa-worker/index.d.ts",
      "import": "./dist/sa-worker.mjs"
    },
    "./sa-worker/locale/*.json": "./rows/sa-worker/locale/*.json",
    "./sa-worker/icon": "./rows/sa-worker/icon.svg"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale/*.json",
    "rows",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FanetheDivine/dsh-plugin-lark-bridge.git"
  },
  "homepage": "https://github.com/FanetheDivine/dsh-plugin-lark-bridge#readme",
  "bugs": {
    "url": "https://github.com/FanetheDivine/dsh-plugin-lark-bridge/issues"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "dev": "pnpm run css:build && tsdown --watch",
    "build": "pnpm run css:build && tsdown && tsc -p tsconfig.build.json && pnpm run test:dist --reporter=minimal --silent=passed-only",
    "check": "pnpm run css:build && pnpm run typecheck && pnpm run lint --diagnostic-level=error && pnpm run test:code --reporter=minimal --silent=passed-only",
    "full-check": "pnpm run check && pnpm run build",
    "release": "pnpm check && pnpm format && npm version patch && node scripts/release-archive.mjs && git push && git push --tags",
    "typecheck": "tsc --noEmit",
    "css:build": "node scripts/build-client-css.mjs",
    "test:code": "pnpm run css:build && vitest run --project code",
    "test:dist": "vitest run --project dist",
    "build:types": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "dsh-plugin-meta-tools": "0.1.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "~1.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-product-analytics": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-title": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tailwindcss/cli": "4.3.5",
    "@tsdown/css": "^0.22.14",
    "@types/node": "^24.19.2",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "immer": "^10.2.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "3.7.1",
    "tailwindcss": "4.3.5",
    "tsdown": "^0.22.14",
    "tw-animate-css": "1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.1",
    "zod": "4.6.6",
    "zustand": "^5.1.0"
  },
  "description": "配置lark-cli即可在手机和dsh对话，体验Super Agent！"
}
